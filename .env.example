# Docker Compose reads this file after you copy it to .env. Local uv runs do not
# load it automatically; export values in the shell for non-Compose overrides.
# MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_TENANT_ID=organizations
# Usually unnecessary: the app discovers BUSY Bars automatically.
# BUSYBAR_HOST=10.0.4.20
# BUSYBAR_NAME=My BUSY Bar
# Required for unattended Compose use when the bar has an access PIN.
BUSYBAR_TOKEN=1234
TZ=Europe/Berlin
# BUSYBAR_MSTEAMS_CONFIG=~/.config/busybar-msteams/config.toml
