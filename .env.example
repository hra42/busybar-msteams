# Copy these values into your shell environment. This project intentionally does
# not load .env files, so credentials cannot be picked up accidentally.
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_TENANT_ID=organizations
# Usually unnecessary: the app discovers BUSY Bars automatically.
# BUSYBAR_HOST=10.0.4.20
# BUSYBAR_NAME=My BUSY Bar
# BUSYBAR_TOKEN=1234
# BUSYBAR_MSTEAMS_CONFIG=~/.config/busybar-msteams/config.toml
